<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Far-left −10s (custom id so media3 doesn't override the icon) -->
    <ImageButton
        android:id="@+id/btnRewind"
        android:layout_width="@dimen/player_seek_button_size"
        android:layout_height="@dimen/player_seek_button_size"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="24dp"
        android:background="@drawable/icon_button_background"
        android:contentDescription="@string/prev"
        android:padding="@dimen/player_seek_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_replay_10" />

    <!-- Far-right +10s -->
    <ImageButton
        android:id="@+id/btnForward"
        android:layout_width="@dimen/player_seek_button_size"
        android:layout_height="@dimen/player_seek_button_size"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="24dp"
        android:background="@drawable/icon_button_background"
        android:contentDescription="@string/next"
        android:padding="@dimen/player_seek_button_padding"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_forward_10" />

    <!-- Center cluster: prev episode / play-pause / next episode -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrevEpisode"
            android:layout_width="@dimen/player_skip_size"
            android:layout_height="@dimen/player_skip_size"
            android:background="@drawable/icon_button_background"
            android:contentDescription="@string/prev"
            android:padding="@dimen/player_skip_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous"
            android:visibility="gone" />

        <ImageButton
            android:id="@id/exo_play_pause"
            android:layout_width="@dimen/player_playpause_size"
            android:layout_height="@dimen/player_playpause_size"
            android:layout_marginStart="@dimen/player_cluster_spacing"
            android:layout_marginEnd="@dimen/player_cluster_spacing"
            android:background="@drawable/icon_button_background"
            android:padding="@dimen/player_playpause_padding"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnNextEpisode"
            android:layout_width="@dimen/player_skip_size"
            android:layout_height="@dimen/player_skip_size"
            android:background="@drawable/icon_button_background"
            android:contentDescription="@string/next"
            android:padding="@dimen/player_skip_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Bottom bar: seek row + option buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                app:buffered_color="#80FFFFFF"
                app:played_color="@color/accent_red"
                app:scrubber_color="@android:color/white"
                app:unplayed_color="#4DFFFFFF" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSubtitles"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/player_button_background"
                android:drawableStart="@drawable/ic_captions"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/subtitles"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSpeed"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/player_button_background"
                android:drawableStart="@drawable/ic_speed"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/speed_default"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnServer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/player_button_background"
                android:drawableStart="@drawable/ic_server"
                android:drawablePadding="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/server"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
